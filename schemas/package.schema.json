{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://captain-cli.local/schemas/embark/package-v1.schema.json",
  "title": "Embark Package Definition v1",
  "type": "object",
  "required": ["schema", "package"],
  "properties": {
    "schema": {
      "const": "embark/package/v1"
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "version",
        "architecture",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "enum": ["x86_64"]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "configFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "transforms": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["type", "path", "value"],
                "properties": {
                  "type": {
                    "const": "elf-rpath"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
